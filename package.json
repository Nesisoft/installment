{
  "name": "installment-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Reusable installment payment engine for the Ghanaian / West African e-commerce market",
  "engines": {
    "node": ">=22",
    "pnpm": ">=10"
  },
  "packageManager": "pnpm@10.33.0",
  "scripts": {
    "dev": "turbo run dev --filter=@installment/api",
    "dev:api": "turbo run dev --filter=@installment/api",
    "dev:customer": "pnpm --filter @installment/customer-web dev",
    "dev:merchant": "pnpm --filter @installment/merchant-web dev",
    "dev:admin": "pnpm --filter @installment/admin-web dev",
    "dev:web": "turbo run dev --filter=@installment/customer-web --filter=@installment/merchant-web --filter=@installment/admin-web",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write \"**/*.{ts,tsx,js,mjs,json,md,yaml,yml}\"",
    "format:check": "prettier --check \"**/*.{ts,tsx,js,mjs,json,md,yaml,yml}\"",
    "migrate": "pnpm --filter @installment/db migrate",
    "db:reset": "pnpm --filter @installment/db reset",
    "db:seed:dev": "pnpm --filter @installment/db seed:dev",
    "create-admin": "pnpm --filter @installment/api build && pnpm --filter @installment/api create:admin",
    "db:introspect": "pnpm --filter @installment/db introspect",
    "db:up": "docker compose --env-file .env -f infra/docker/docker-compose.yml up -d",
    "db:down": "docker compose --env-file .env -f infra/docker/docker-compose.yml down",
    "openapi:emit": "pnpm build && pnpm --filter @installment/api openapi:emit",
    "prepare": "husky"
  },
  "devDependencies": {
    "@eslint/js": "^9.15.0",
    "eslint": "^9.15.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.2.10",
    "prettier": "^3.4.1",
    "turbo": "^2.3.3",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.16.0"
  },
  "lint-staged": {
    "*.{ts,tsx,js,mjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yaml,yml}": [
      "prettier --write"
    ]
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ],
    "overrides": {
      "drizzle-orm": "0.45.2"
    }
  }
}
