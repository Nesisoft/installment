# ============================================================================
# Installment Payment Engine — environment variables
# Copy to .env and fill in. Never commit .env.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- Database (Postgres 16) ------------------------------------------------
# Used by the API, the migration runner, and drizzle-kit introspect.
#
# If you already run PostgreSQL natively on this machine, port 5432 is taken.
# Pick a free host port (e.g. 5433) and change BOTH lines below: POSTGRES_PORT
# and the port inside DATABASE_URL must match. The container always listens on
# 5432 internally; POSTGRES_PORT only remaps the host side.
DATABASE_URL=postgresql://installment:installment@localhost:5432/installment

# Consumed by docker-compose (infra/docker/docker-compose.yml).
# `pnpm db:up` passes this file via `--env-file`, so these values are
# authoritative for the containers (not just the app).
POSTGRES_USER=installment
POSTGRES_PASSWORD=installment
POSTGRES_DB=installment
POSTGRES_PORT=5432

# --- Redis 7 ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379
REDIS_PORT=6379

# --- CORS (Phase 10 browser apps) ------------------------------------------
# Comma-separated origin allowlist for the React apps. Defaults cover the three
# Vite dev servers (customer :5173, merchant :5174, admin :5175). Use "*" to
# reflect any origin in local dev. In production list the real app hostnames.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175

# --- pgAdmin (docker-compose only) -----------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@installment.local
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- Auth (JWT + OTP) ------------------------------------------------------
# Dev defaults exist so `pnpm dev` works out of the box. In production these
# MUST come from a secret store and be long random strings (see §5 Security).
JWT_ACCESS_SECRET=dev-access-secret-change-me!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me!!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
SMS_SENDER_ID=Installmt

# --- Observability ---------------------------------------------------------
# Leave SENTRY_DSN empty to disable Sentry (it no-ops when unset).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# --- Paystack (used from Phase 6 onward — documented now) ------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co

# --- SMS providers (used from Phase 2/3 onward — documented now) ----------
SMS_PROVIDER=hubtel
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
HUBTEL_SENDER_ID=
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
