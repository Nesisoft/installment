# ============================================================================
# Installment Payment Engine — environment variables
# Copy to .env and fill in. Never commit .env.
# ============================================================================

# --- Runtime ---------------------------------------------------------------
NODE_ENV=development
PORT=3000
# pino level: trace | debug | info | warn | error | fatal
LOG_LEVEL=debug

# --- Database (Postgres 16) ------------------------------------------------
# Used by the API, the migration runner, and drizzle-kit introspect.
#
# If you already run PostgreSQL natively on this machine, port 5432 is taken.
# Pick a free host port (e.g. 5433) and change BOTH lines below: POSTGRES_PORT
# and the port inside DATABASE_URL must match. The container always listens on
# 5432 internally; POSTGRES_PORT only remaps the host side.
DATABASE_URL=postgresql://installment:installment@localhost:5432/installment
# Supabase: the SESSION pooler string, with the project's CA certificate. Not
# sslmode=require, which pg treats as "verify against the system CAs" and fails:
#   postgresql://postgres.<ref>:<pw>@aws-<n>-<region>.pooler.supabase.com:5432/postgres?sslmode=verify-full&sslrootcert=/path/to/supabase-ca.crt
# See docs/deployment/render.md §1.1.
#
# Most connections this API holds. Every process sharing the database counts
# against its limit (Supabase's default pool is 15), so keep this low there.
DATABASE_POOL_MAX=10

# Consumed by docker-compose (infra/docker/docker-compose.yml).
# `pnpm db:up` passes this file via `--env-file`, so these values are
# authoritative for the containers (not just the app).
POSTGRES_USER=installment
POSTGRES_PASSWORD=installment
POSTGRES_DB=installment
POSTGRES_PORT=5432

# --- Redis 7 ---------------------------------------------------------------
REDIS_URL=redis://localhost:6379
# Upstash: rediss://default:<password>@<endpoint>.upstash.io:6379 (TLS, two s's).
REDIS_PORT=6379
# The retry queue's idle polling, in seconds (BullMQ drainDelay / stalledInterval).
# The defaults suit a local Redis. On Upstash, which bills per command, set both
# to 300: an idle API then sends ~2 commands a minute instead of ~100.
QUEUE_DRAIN_DELAY_SECONDS=5
QUEUE_STALLED_INTERVAL_SECONDS=30

# --- CORS (Phase 10 browser apps) ------------------------------------------
# Comma-separated origin allowlist for the React apps. Defaults cover the three
# Vite dev servers (customer :5173, merchant :5174, admin :5175) plus Metro's
# web preview (:8081, for `expo start --web`). Use "*" to reflect any origin in
# local dev. In production list the real app hostnames.
#
# Irrelevant to the mobile app on a device or emulator: React Native's native
# networking sends no Origin header and enforces no same-origin policy, so
# adding a phone's address here fixes nothing. Only the web preview needs it.
#
# 8081 is Metro's default and 8082 is what Expo offers when 8081 is taken —
# which is what happens the moment you run the shopper and seller apps at the
# same time. Both are listed so the second one to start still works on web.
CORS_ORIGINS=http://localhost:5173,http://localhost:5174,http://localhost:5175,http://localhost:8081,http://localhost:8082

# --- pgAdmin (docker-compose only) -----------------------------------------
PGADMIN_DEFAULT_EMAIL=admin@installment.local
PGADMIN_DEFAULT_PASSWORD=admin
PGADMIN_PORT=5050

# --- Auth (JWT + OTP) ------------------------------------------------------
# Dev defaults exist so `pnpm dev` works out of the box. In production these
# MUST come from a secret store and be long random strings (see §5 Security);
# the API refuses to start with NODE_ENV=production on these published values.
JWT_ACCESS_SECRET=dev-access-secret-change-me!!
JWT_REFRESH_SECRET=dev-refresh-secret-change-me!!
JWT_ACCESS_TTL_SECONDS=900
JWT_REFRESH_TTL_SECONDS=2592000
# --- Credit policy ---
# What a customer with NO borrowing history may be lent on a first order, in
# cedis, measured on what the plan FINANCES rather than what the order costs
# (GHS 400 at a 40% deposit lends 240; the same order at 0% lends the whole 400).
#
# It exists because without it nobody new can be approved at all: every rule
# worth points needs a history to have points about, so a verified, blameless
# first-time shopper scores 275 against a 350 floor and is declined. This is the
# deliberate appetite for being wrong about someone we know nothing about — the
# most that can be lost per new customer. `0` switches the policy off and
# restores the previous decline-everyone behaviour.
CREDIT_STARTER_MAX_FINANCED_GHS=250

# The same ceiling when a VERIFIED link to an ACTIVE employer exists — the one
# thing about a first-time customer that somebody outside this company has
# confirmed. Not the bare link: an operator types those and they land active
# immediately, so lending against one would be lending against data entry.
CREDIT_STARTER_MAX_FINANCED_EMPLOYER_GHS=750

# And when that link also carries payroll-deduction consent. The largest step,
# because it is the only tier where repayment does not depend on the customer
# choosing to pay — the employer remits from salary before it reaches them.
CREDIT_STARTER_MAX_FINANCED_PAYROLL_GHS=2000

# Which push provider delivers. `console` logs and sends nothing — fine locally,
# refused in production, where a merchant who is not told an order arrived does
# not confirm it. EXPO_ACCESS_TOKEN is only needed if the Expo project has
# "Enhanced Security for Push Notifications" enabled.
PUSH_PROVIDER=console
EXPO_ACCESS_TOKEN=
EXPO_PUSH_BASE_URL=https://exp.host

SMS_SENDER_ID=Installmt

# --- Observability ---------------------------------------------------------
# Leave SENTRY_DSN empty to disable Sentry (it no-ops when unset).
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
SENTRY_TRACES_SAMPLE_RATE=0

# Prometheus scrape token for GET /metrics (at least 24 characters). Leave
# unset and the endpoint answers 404. See infra/observability/README.md.
# METRICS_TOKEN=

# --- Sellers owing Ejua ---------------------------------------------------
# The daily alert fires when the total sellers owe (negative payables, mostly
# from returns) reaches this many pesewas — and always for a seller who owes
# and can no longer be paid out. 500000 = GHS 5,000.
SELLERS_OWING_ALERT_PESEWAS=500000

# --- Paystack (used from Phase 6 onward — documented now) ------------------
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_WEBHOOK_SECRET=
PAYSTACK_BASE_URL=https://api.paystack.co
# Accounts opened with only a phone number have no email; Paystack is given
# <phone>@<this domain> for them, since it refuses the placeholder signup stores.
# Must be a domain Ejua controls that publishes a null MX ("MX 0 ."), or
# Paystack's receipts reach whoever owns it. The API warns at boot in
# production when it does not: docs/runbooks/standin-email-domain.md.
PAYSTACK_STANDIN_EMAIL_DOMAIN=customers.ejua.gh

# --- SMS providers -------------------------------------------------------
# `console` logs and delivers nothing. Customer login is phone+OTP only, so the
# API refuses to boot with NODE_ENV=production on this setting.
# Hubtel is the provider we ship with. Get ClientID/ClientSecret from the
# Hubtel dashboard (or your Retail Systems Engineer) and set them here; the API
# refuses to boot with SMS_PROVIDER=hubtel and either one blank.
# SMS_SENDER_ID must be at most 11 characters and pre-registered with Hubtel.
SMS_PROVIDER=console
HUBTEL_CLIENT_ID=
HUBTEL_CLIENT_SECRET=
# Sender ID as approved on YOUR Hubtel account (max 11 chars). Hubtel rejects
# any other with "Invalid Source address", so this wins over SMS_SENDER_ID.
HUBTEL_SENDER_ID=
# Full send endpoint. Preferred over HUBTEL_BASE_URL when set.
HUBTEL_SMS_URL=https://sms.hubtel.com/v1/messages/send
HUBTEL_BASE_URL=https://sms.hubtel.com
# Arkesel is kept as an alternate transport; leave blank unless SMS_PROVIDER=arkesel.
ARKESEL_API_KEY=
ARKESEL_SENDER_ID=
ARKESEL_BASE_URL=https://sms.arkesel.com
# Print the full SMS body (including login OTPs) to the log. Local dev only —
# also refused under NODE_ENV=production.
SMS_LOG_BODY=false

# --- Rate limiting (Phase 10) -------------------------------------------
# Global ceiling per client per window; per-route overrides tighten auth.
# Set TRUST_PROXY behind a load balancer (hop count, or "true"), otherwise every
# request appears to come from the proxy and shares one bucket.
RATE_LIMIT_ENABLED=true
RATE_LIMIT_LIMIT=300
RATE_LIMIT_WINDOW_SECONDS=60
TRUST_PROXY=

# Hours an unpaid order may hold its stock before the hourly sweep cancels it.
ORDER_PAYMENT_TTL_HOURS=24

# --- Object storage (product images, store artwork, KYC scans) -----------
# Which backend accepts uploads. `none` answers 503 on every upload request but
# still resolves existing images, so a deployment without storage degrades
# quietly. `local` writes through the API to disk — development only, and
# refused outright under NODE_ENV=production. `s3` covers every provider that
# verifies a SigV4 signature: AWS S3, Cloudflare R2, DigitalOcean Spaces, MinIO.
STORAGE_DRIVER=local
STORAGE_LOCAL_DIR=.media
# Signs the local driver's upload tokens. Production refuses to boot on this
# published value.
STORAGE_UPLOAD_SECRET=dev-upload-secret-change-me!!
# Origin the API is reachable at, which the local driver puts in the URLs it
# hands out. A phone or emulator cannot reach `localhost` — set this to the host
# machine's LAN address (Android emulator: http://10.0.2.2:3000).
PUBLIC_API_URL=http://localhost:3000
# Largest single upload a URL is issued for, and how long that URL lives.
STORAGE_MAX_UPLOAD_BYTES=10485760
STORAGE_UPLOAD_TTL_SECONDS=300

# --- STORAGE_DRIVER=s3 --------------------------------------------------
# ONE bucket, private by default. Objects carry their visibility in the key:
# `public/` (product images, store and category artwork) and `private/` (KYC
# documents). Grant anonymous GET on `public/*` ONLY — via bucket policy, or by
# pointing a CDN at the bucket with `/public` as its origin path. Everything
# under `private/` must stay unreadable without a signature; a Ghana Card scan
# is personal data under the Data Protection Act, 2012 (Act 843).
#
# A presigned PUT cannot bound a size the client never committed to, so set an
# object-size limit on the bucket as well — the API's own ceiling is checked
# before a URL is minted, which catches the honest case but not a hostile one.
STORAGE_BUCKET=
STORAGE_REGION=eu-west-1
# Empty means AWS. R2: https://<account>.r2.cloudflarestorage.com (path style).
# Spaces: https://fra1.digitaloceanspaces.com. MinIO: http://localhost:9000.
STORAGE_ENDPOINT=
STORAGE_FORCE_PATH_STYLE=false
STORAGE_ACCESS_KEY_ID=
STORAGE_SECRET_ACCESS_KEY=
# Public prefix `public/` objects are served from, e.g. https://cdn.ejua.gh.
# Becomes MEDIA_BASE_URL when that is unset, so storage is one variable to set
# rather than two that have to agree.
STORAGE_PUBLIC_URL=
# Overrides the above when a CDN sits on a different hostname from the bucket.
# Both empty means every image URL resolves to null and the apps draw their
# placeholder tile.
MEDIA_BASE_URL=
