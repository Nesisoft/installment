# Base URL of the installment/marketplace API the app talks to.
#
# The Android emulator cannot reach the host's "localhost" — 10.0.2.2 is the
# host loopback as seen from inside the emulator. On a physical handset use your
# machine's LAN address (e.g. http://192.168.1.20:3000) and make sure the API is
# bound to 0.0.0.0, not 127.0.0.1.
#
#   Android emulator : http://10.0.2.2:3000
#   iOS simulator    : http://localhost:3000
#   Physical device  : http://<your-lan-ip>:3000
#   Expo web preview : http://localhost:3000
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
