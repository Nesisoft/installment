# Base URL of the installment/marketplace API the app talks to.
#
# DO NOT copy this file verbatim for a physical handset. The default below is
# the Android emulator's NAT alias for the host loopback and exists nowhere
# else — on a real phone the packets are dropped rather than refused, so you
# get a 20-second hang and "We couldn't reach Ejua" on every screen, which
# reads as a flaky network rather than a wrong address. Write your LAN address:
#
#   printf 'EXPO_PUBLIC_API_URL=http://192.168.1.20:3000\n' > .env
#
#   Android emulator : http://10.0.2.2:3000
#   iOS simulator    : http://localhost:3000
#   Physical device  : http://<your-lan-ip>:3000
#   Expo web preview : http://localhost:3000
#
# This is inlined into the bundle at transform time, not read at runtime, so a
# running Metro keeps serving the old value — restart with `npx expo start -c`.
#
# It is also only HALF the configuration. Image URLs are built from
# PUBLIC_API_URL in the REPO-ROOT .env, read by the API, not by Expo. Leave that
# at localhost and the app works while every picture renders blank, with nothing
# in either log. See ../../docs/design/object-storage.md.
EXPO_PUBLIC_API_URL=http://10.0.2.2:3000
