{
  "compilerOptions": {
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUncheckedIndexedAccess": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    // This package's own React types, for every file that imports 'react' —
    // library declarations included. The workspace has @types/react 18 (web)
    // and 19 (Expo); without this, a library whose types import 'react' with
    // no @types peer (lucide-react, react-router) gets whichever version pnpm
    // hoisted, and CI failed whenever that was 19.
    "paths": {
      "react": ["./node_modules/@types/react"],
      "react/*": ["./node_modules/@types/react/*"]
    },
    "types": ["vite/client"]
  },
  "include": ["src"]
}
