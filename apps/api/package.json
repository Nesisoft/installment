{
  "name": "@installment/api",
  "version": "0.0.0",
  "private": true,
  "main": "dist/main.js",
  "scripts": {
    "build": "nest build",
    "dev": "nest start --watch",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "openapi:emit": "node dist/tools/emit-openapi.js",
    "create:admin": "node --env-file-if-exists=../../.env dist/tools/create-admin.js",
    "repair:money": "node --env-file-if-exists=../../.env dist/tools/money-repairs.js"
  },
  "dependencies": {
    "@installment/commerce": "workspace:*",
    "@installment/core": "workspace:*",
    "@installment/db": "workspace:*",
    "@installment/paystack-client": "workspace:*",
    "@installment/push-client": "workspace:*",
    "@installment/sms-client": "workspace:*",
    "@installment/storage-client": "workspace:*",
    "@nestjs/common": "^11.0.1",
    "@nestjs/config": "^4.0.0",
    "@nestjs/core": "^11.0.1",
    "@nestjs/platform-express": "^11.0.1",
    "@nestjs/schedule": "^5.0.1",
    "@nestjs/swagger": "^11.0.0",
    "@sentry/node": "^8.42.0",
    "bullmq": "^5.78.0",
    "drizzle-orm": "^0.45.2",
    "ioredis": "^5.4.2",
    "nestjs-pino": "^4.2.0",
    "pino": "^9.5.0",
    "pino-http": "^10.3.0",
    "pino-pretty": "^13.0.0",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.24.1",
    "zod-to-json-schema": "^3.25.2"
  },
  "devDependencies": {
    "@installment/api-types": "workspace:*",
    "@nestjs/cli": "^11.0.0",
    "@nestjs/schematics": "^11.0.0",
    "@nestjs/testing": "^11.0.1",
    "@types/express": "^5.0.0",
    "@types/node": "^22.10.2",
    "@types/supertest": "^6.0.2",
    "supertest": "^7.0.0",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
